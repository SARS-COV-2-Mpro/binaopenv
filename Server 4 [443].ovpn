
dev tun


proto tcp


remote s4.irxs.us 443

;http-proxy-retry
;http-proxy [proxy server] [proxy port]


cipher AES-128-CBC
auth SHA1


resolv-retry infinite
nobind
persist-key
persist-tun
client
verb 3

auth-user-pass


